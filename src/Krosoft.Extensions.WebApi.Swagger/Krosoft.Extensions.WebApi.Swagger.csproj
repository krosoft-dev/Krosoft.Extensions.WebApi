<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
		<PackageTags>Krosoft Extension Web Api AspNetCore swagger</PackageTags>
		<Description>Package pour faciliter l'utilisation de Swagger avec ASP.NET Core.</Description>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
		<PackageReference Include="Krosoft.Extensions.Core" Version="2026.11.16.13768" />
	</ItemGroup>
</Project>
